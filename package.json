{
  "name": "huroofi",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "validate:content": "pnpm --filter @huroofi/content-validator run validate",
    "guard:offline": "pnpm --filter @huroofi/offline-network-guard run check",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm validate:content && pnpm guard:offline",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "unrs-resolver"
    ]
  }
}
